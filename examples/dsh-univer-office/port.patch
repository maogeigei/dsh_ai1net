+/**
+ * Idle watchdog（2026-09-13 · 方案 E）：**没有任何请求、也没有活跃 WS 客户端**且静默超过阈值时，
+ * 让 gateway **自行退出**，把 ~390 MB 内存还给实例；下次需要时由 host 的
+ * `GatewaySupervisor.ensure()`（每次都会先探活）自动重新拉起。
+ *
+ * 为什么必须放在 gateway 侧：浏览器与 unit-content-worker 都是**直接走 unix socket** 的，
+ * host 看不到这部分流量 ⇒ 在 host 侧判空闲会把"忙"误判成"闲"，可能把正在编辑的 gateway 停掉。
+ * 阈值：env `UNIVER_DSH_GATEWAY_IDLE_MS`（默认 600000 = 10 分钟；**0 = 关闭本机制**）。
+ */
+function startIdleWatchdog(input: {
+  readonly httpServer: http.Server
+  readonly wss: { readonly clients: Set<unknown> }
+}): void {
+  const idleMs = Number(process.env.UNIVER_DSH_GATEWAY_IDLE_MS ?? '600000')
+  if (!Number.isFinite(idleMs) || idleMs <= 0) return
+  let lastActivity = Date.now()
+  // 每个 HTTP 请求都算活动；WS 心跳不算（靠 clients.size 判"有没有人在看"）。
+  input.httpServer.on('request', () => {
+    lastActivity = Date.now()
+  })
+  const interval = Math.min(60_000, Math.max(5_000, Math.floor(idleMs / 4)))
+  const timer = setInterval(() => {
+    if (input.wss.clients.size > 0) {
+      lastActivity = Date.now()
+      return
+    }
+    if (Date.now() - lastActivity < idleMs) return
+    clearInterval(timer)
+    process.stdout.write(
+      `[dsh-univer-gateway] idle ${String(Math.round(idleMs / 1000))}s with no client → exiting to release memory\n`
+    )
+    process.exit(0)
+  }, interval)
+  timer.unref?.()
+}
