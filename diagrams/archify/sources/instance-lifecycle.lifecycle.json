  "cards": [
    {
      "dot": "emerald",
      "title": "Main lifecycle",
      "items": [
        "A workspace starts on first use and stays resident while in use",
        "Idle time makes its memory reclaimable; reclaiming returns memory without discarding the workspace"
      ]
    },
    {
      "dot": "cyan",
      "title": "Return and recovery",
      "items": [
        "Returning to a reclaimed instance starts it again on demand, and the conversation continues",
        "A crash is repaired in place; repeated crashes widen the interval and starts are refused during it"
      ]
    }
