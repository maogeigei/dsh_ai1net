  "cards": [
    {
      "dot": "cyan",
      "title": "Detect",
      "items": [
        "The browser never talks to an instance port directly",
        "The control plane decides from stored state whether a process exists",
        "A reclaimed instance is a normal state, not an error"
      ]
    },
    {
      "dot": "emerald",
      "title": "Wake",
      "items": [
        "The process is spawned under the owner's own operating-system account",
        "It binds a loopback port only, and never a public one",
        "The user gets a wake notice rather than a failure page"
      ]
    },
    {
      "dot": "orange",
      "title": "Resume",
      "items": [
        "Traffic is proxied only after the port is reported ready",
        "The conversation continues where it stopped",
        "Wake, proxy and confinement are separate steps on purpose"
      ]
    }
  ]
