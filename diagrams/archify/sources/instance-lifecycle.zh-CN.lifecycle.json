  "cards": [
    {
      "dot": "emerald",
      "title": "主生命周期",
      "items": [
        "工作区在首次使用时启动，使用期间常驻",
        "空闲时间让它的内存可被回收；回收只归还内存，不丢弃工作区"
      ]
    },
    {
      "dot": "cyan",
      "title": "回到页面与恢复",
      "items": [
        "回到已回收的实例时按需再次启动，对话从上次停下的地方继续",
        "崩溃后就地修复；反复崩溃会拉长间隔，期间拒绝启动"
      ]
    }
  ]
