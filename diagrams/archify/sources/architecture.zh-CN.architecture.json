  "cards": [
    {
      "dot": "cyan",
      "title": "请求链路",
      "items": [
        "nginx 为主域和一组泛子域终止 TLS",
        "控制面按 Host 头或 /u/<userId>/dsh/* 路由",
        "每个实例只绑回环端口，从不直接对外暴露"
      ]
    },
    {
      "dot": "emerald",
      "title": "每用户隔离",
      "items": [
        "每个用户有独立系统账号、独立 harness 进程和私有文件根",
        "路径围栏把实例限制在自己的目录内",
        "端口护栏把监听套接字钉在回环上，出网护栏过滤对外流量"
      ]
    },
    {
      "dot": "rose",
      "title": "基座、治理与自愈",
      "items": [
        "基座原样使用，不修改也不内嵌 —— 每个用户一个子进程",
        "账号自助注册、管理员审核通过才启用；插件与技能只来自管理员维护的候选池",
        "崩溃时先拉起守护实例修复配置再重启；反复崩溃会退避并触发熔断；空闲实例被回收以归还内存"
      ]
    }
  ]
