  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "nginx terminates TLS; the control plane routes by Host or /u/<userId>/dsh/*",
        "Each instance binds a loopback port and is never exposed directly"
      ]
    },
    {
      "dot": "emerald",
      "title": "Per-user isolation",
      "items": [
        "One operating-system account, one harness process and one private file root per user",
        "A path fence confines the instance; the port and egress guards pin and filter it"
      ]
    },
    {
      "dot": "rose",
      "title": "Base, governance, self-healing",
      "items": [
        "The harness is used unmodified — one child process per user",
        "Accounts need administrator approval, and plugins come from a managed pool",
        "A crash is repaired then restarted; crashes back off, and idle instances are reaped"
      ]
    }
  ]
