  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership",
      "items": [
        "Which host owns a user's instance is settled by an atomic claim in a shared database",
        "The lease carries a time to live that is renewed periodically, and every write is stamped with an epoch so the owner is never ambiguous",
        "Single-machine mode gets the same guarantee for free from an in-process map"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the user gets",
      "items": [
        "Nothing changes from the user's side: same request path, same conversation, same files",
        "Instances still bind loopback ports only",
        "The worker exposes a token-authenticated surface for instance lifecycle and file operations"
      ]
    },
    {
      "dot": "orange",
      "title": "One baseline",
      "items": [
        "Every worker uses the same absolute data root, so an instance's paths mean the same thing on any host",
        "The worker reuses the single-machine spawner and the same path-safety code",
        "Isolation, memory quotas, crash backoff and plugin probes behave identically"
      ]
    }
  ]
