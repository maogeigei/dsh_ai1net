# ============================================================================
# DSH 平台 — 部署配置模板
# ----------------------------------------------------------------------------
# 用法：cp config/platform.env.example config/platform.env  → 按本机实际填写
#   · platform.env 已被 .gitignore 排除，**不会入库**
#   · 代码里不含任何真实部署值；所有部署相关的值都从本文件（或同名 env）读取
#   · 也可以用系统级 env 覆盖（systemd drop-in / /etc/dsh_ai1net.env），优先级见 config/README.md
# ============================================================================

# --- 数据根：每用户 home / ws / 平台库 都在这下面 -------------------------
DSH_AI1NET_DATA_ROOT=/var/lib/dsh-ai1net

# --- 平台私有目录的父目录：其下放 state / backups / artifacts -------------
# 代码里的 stateDir / backupDir / artifactDir 都由它派生，见 src/config.ts
DSH_PLATFORM_DIR=/var/lib/dsh-ai1net/platform

# --- 代码安装根（lib/ 与 scripts/ 所在）----------------------------------
DSH_INSTALL_DIR=<INSTALL_DIR>

# --- 对外域名 -------------------------------------------------------------
DSH_AI1NET_BASE_DOMAIN=example.com
DSH_AI1NET_COOKIE_DOMAIN=.example.com

# --- 监听端口 / 隔离方式 --------------------------------------------------
DSH_AI1NET_PORT=3080
DSH_AI1NET_ISOLATION_MODE=account
DSH_AI1NET_BASE_UID=100000

# --- 部署形态：local | cluster --------------------------------------
DSH_AI1NET_DEPLOY_MODE=local
DSH_AI1NET_CLUSTER_HOST_ID=<host-id>
DSH_AI1NET_CLUSTER_INSTANCE_HOST=127.0.0.1
DSH_AI1NET_CLUSTER_WORKER_DATA_ROOT=/var/lib/dsh-ai1net

# --- 覆盖网络引导种子（逗号分隔；留空 = 功能关闭）------------------------
DSH_AI1NET_OVERLAY_BOOTSTRAP_SEEDS=

# --- 本机地址（出网护栏脚本用；填自己的公网/内网地址）--------------------
DSH_HOST_PUBLIC_IP=<server-public-ip>
DSH_HOST_LAN_IP=<host-lan-ip>

# --- 控制面 PG（cluster 形态用）-------------------------------------------
DSH_AI1NET_PG_HOST=127.0.0.1
DSH_AI1NET_PG_PORT=<pg-port>
DSH_AI1NET_PG_USER=dsh_ai1net
DSH_AI1NET_PG_DB=dsh_ai1net
DSH_AI1NET_PG_PASSWORD=<pg-password>
DSH_PG_DATA_DIR=/var/lib/dsh-pg

# --- Worker 注册凭据（cluster 形态必填）----------------------------------
DSH_AI1NET_CLUSTER_AGENT_TOKEN=<worker-token>

# --- 反向隧道目标（可选；留空 = 隧道关闭）--------------------------------
# 形如 root@<host>:<port> 或 ssh://root@<host>:<port>
DSH_AI1NET_TUNNEL_TARGET=

# --- 平台库连接（cluster 形态用 PG；local 形态留空走 SQLite）-------------
DSH_AI1NET_DB_URL=

# --- 注册验证外发（留空 = 该能力关闭）-----------------------------------
DSH_AI1NET_MAIL_DRIVER=
DSH_AI1NET_MAIL_API_KEY=
DSH_AI1NET_MAIL_FROM=
DSH_AI1NET_MAIL_FROM_NAME=
DSH_AI1NET_TURNSTILE_SITE_KEY=
DSH_AI1NET_TURNSTILE_SECRET=
DSH_AI1NET_TURNSTILE_HOSTNAMES=
